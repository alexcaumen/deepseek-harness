{
  "name": "@deepseek-ai/dsh-model-lifecycle",
  "description": "Provider-neutral transactional lifecycle controller for governed local models",
  "version": "0.1.1-rc.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/model-lifecycle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
